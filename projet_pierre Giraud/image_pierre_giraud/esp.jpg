/* Start custom CSS for nested-accordion, class: .elementor-element-a5a4ac4 */.smobmen ul {
  list-style-type: none; /* Remove bullets */
  padding: 0 10px; /* Remove padding */
  margin: 5px; /* Remove margins */
}

.smobmen ul li{
