/* Start custom CSS for nav-menu, class: .elementor-element-316f4f3 *//* =====================================================
   MENU PRINCIPAL - LE SOLEIL
   Ancien menu + nouveau menu + menu test
===================================================== */

/* Cible le bouton trois barres */
.elementor-12395 .elementor-element.elementor-element-316f4f3 .menu-item-15271 > a.elementor-item,
.elementor-12395 .elementor-element.elementor-element-316f4f3 .menu-burger-more > a.elementor-item,
.elementor-12395 .elementor-element.elementor-element-316f4f3 .elementor-nav-menu > li:last-child > a.elementor-item {
    text-indent: -9999px !important;
    width: 45px !important;
    min-width: 45px !important;
    height: 35px !important;
    padding: 0 !important;
    display: inline-block !important;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg' stroke='%23ffffff'%3E%3Cpath d='M3.5 7.5H20.5' stroke='%23ffffff' stroke-linecap='round'/%3E%3Cpath d='M3.5 12H17.5' stroke='%23ffffff' stroke-linecap='round'/%3E%3Cpath d='M3.5 16.5H20.5' stroke='%23ffffff' stroke-linecap='round'/%3E%3C/svg%3E") no-repeat center !important;
    background-size: 35px 35px !important;
}

/* Cache la flèche du bouton trois barres */
.elementor-12395 .elementor-element.elementor-element-316f4f3 .menu-item-15271 > a.elementor-item .sub-arrow,
.elementor-12395 .elementor-element.elementor-element-316f4f3 .menu-burger-more > a.elementor-item .sub-arrow,
.elementor-12395 .elementor-element.elementor-element-316f4f3 .elementor-nav-menu > li:last-child > a.elementor-item .sub-arrow {
    display: none !important;
}

/* Style des sous-menus */
.elementor-12395 .elementor-element.elementor-element-316f4f3 .sub-menu {
    background: #ffffff !important;
    padding: 20px !important;
    box-shadow:
        2.8px 2.8px 2.2px rgba(0, 0, 0, 0.014),
        6.7px 6.7px 5.3px rgba(0, 0, 0, 0.02),
        12.5px 12.5px 10px rgba(0, 0, 0, 0.025),
        22.3px 22.3px 17.9px rgba(0, 0, 0, 0.03),
        41.8px 41.8px 33.4px rgba(0, 0, 0, 0.036),
        100px 100px 80px rgba(0, 0, 0, 0.05) !important;
}

/* Style des éléments dans les dropdowns */
.elementor-12395 .elementor-element.elementor-element-316f4f3 .sub-menu .menu-item {
    border-left: solid 8px #ee1c24 !important;
    margin-bottom: 10px !important;
}

/* Liens des sous-menus */
.elementor-12395 .elementor-element.elementor-element-316f4f3 .sub-menu .menu-item > a {
    color: #111 !important;
    background: transparent !important;
    padding-left: 20px !important;
    font-size: 16px !important;
    font-weight: 500 !important;
}

/* Survol */
.elementor-12395 .elementor-element.elementor-element-316f4f3 .sub-menu .menu-item > a:hover {
    color: #ee1c24 !important;
    background: transparent !important;
}

/* Responsive */
@media screen and (max-width: 1270px) {
    .elementor-12395 .elementor-element.elementor-element-316f4f3 .elementor-nav-menu > li > a.elementor-item {
        font-size: 1vw !important;
        font-weight: 500 !important;
    }
}/* End custom CSS */
