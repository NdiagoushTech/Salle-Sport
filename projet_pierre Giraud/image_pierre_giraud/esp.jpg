    content: "";
    display: block;
    width: 5px;
    height: 100%;
    background-color: #ddd;
    transform: skew(0deg, 45deg);
    position: absolute;
    right: -4px;
    top:2px
}

.miniombre:before {
    content: "";
    display: block;
    width: 100%;
    height: 5px;
    background-color: #ddd;
    transform: skew(45deg, 0deg)  translateY(0px);
    position: absolute;
    left: 2px;
    top:100%
    
}

