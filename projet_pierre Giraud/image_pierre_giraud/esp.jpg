}


/* ==========================================================
   CORRECTIF COMPLET PAGE RÉGIONS - LE SOLEIL
   Objectif : remplacer le rouge par le bleu uniquement
   Scope : page /rubriques/regions/
   ========================================================== */

body.category-regions {
  --region-blue: #005BBB;
  --region-blue-dark: #004A99;
  --region-red: #EE1C24;
}

/* ==========================================================
   1. BOUTONS / ÉLÉMENTS BLEUS GÉNÉRAUX
   ========================================================== */

body.category-regions .elementor-button,
body.category-regions .elementor-button-link,
body.category-regions button,
body.category-regions input[type="submit"],
body.category-regions .search-submit,
body.category-regions .elementor-search-form__submit {
  background-color: var(--region-blue) !important;
  border-color: var(--region-blue) !important;
  color: #ffffff !important;
}

body.category-regions .elementor-button:hover,
body.category-regions .elementor-button-link:hover,
body.category-regions button:hover,
body.category-regions input[type="submit"]:hover,
body.category-regions .search-submit:hover,
body.category-regions .elementor-search-form__submit:hover {
  background-color: var(--region-blue-dark) !important;
  border-color: var(--region-blue-dark) !important;
  color: #ffffff !important;
}

/* ==========================================================
   2. BARRES / TRAITS ROUGES DEVENUS BLEUS
   ========================================================== */

body.category-regions .grostitre,
body.category-regions .gros-titre,
body.category-regions .section-title,
body.category-regions .widget-title,
body.category-regions [class*="grostitre"],
body.category-regions [class*="gros-titre"] {
  border-color: var(--region-blue) !important;
}

body.category-regions .grostitre::before,
body.category-regions .grostitre::after,
body.category-regions .gros-titre::before,
body.category-regions .gros-titre::after,
body.category-regions .section-title::before,
body.category-regions .section-title::after,
body.category-regions .widget-title::before,
body.category-regions .widget-title::after,
body.category-regions .elementor-heading-title::before,
body.category-regions .elementor-heading-title::after {
  background-color: var(--region-blue) !important;
  border-color: var(--region-blue) !important;
}

/* ==========================================================
   3. MENU PRINCIPAL
   ========================================================== */

body.category-regions .elementor-nav-menu > li > a,
body.category-regions .elementor-nav-menu > li > .elementor-item {
  color: #ffffff !important;
}

body.category-regions .elementor-nav-menu > li > a::before,
body.category-regions .elementor-nav-menu > li > a::after,
body.category-regions .elementor-nav-menu > li > .elementor-item::before,
body.category-regions .elementor-nav-menu > li > .elementor-item::after {
  background-color: var(--region-blue) !important;
  border-color: var(--region-blue) !important;
}

body.category-regions .elementor-nav-menu > li,
body.category-regions .elementor-nav-menu > li > a,
body.category-regions .elementor-nav-menu > li > .elementor-item {
  border-color: var(--region-blue) !important;
}

/* ==========================================================
   4. DROPDOWNS / SOUS-MENUS
   ========================================================== */

body.category-regions .elementor-nav-menu--dropdown,
body.category-regions .elementor-nav-menu--dropdown.sub-menu,
body.category-regions ul.sub-menu {
  background-color: #ffffff !important;
}

body.category-regions .elementor-nav-menu--dropdown .menu-item > a,
body.category-regions .elementor-nav-menu--dropdown .elementor-sub-item,
body.category-regions ul.sub-menu .menu-item > a,
body.category-regions ul.sub-menu .elementor-sub-item {
  color: #111111 !important;
  background-color: transparent !important;
}

body.category-regions .elementor-nav-menu--dropdown .menu-item > a:hover,
body.category-regions .elementor-nav-menu--dropdown .elementor-sub-item:hover,
body.category-regions ul.sub-menu .menu-item > a:hover,
body.category-regions ul.sub-menu .elementor-sub-item:hover {
  color: #111111 !important;
  background-color: transparent !important;
}

body.category-regions .elementor-12395 .elementor-element.elementor-element-316f4f3 .sub-menu .menu-item {
  border-left: solid 8px var(--region-blue) !important;
  margin-bottom: 10px !important;
}

body.category-regions .elementor-nav-menu--dropdown .menu-item,
body.category-regions ul.sub-menu .menu-item {
  border-left-color: var(--region-blue) !important;
}

body.category-regions .elementor-nav-menu--dropdown .menu-item > a,
body.category-regions .elementor-nav-menu--dropdown .elementor-sub-item,
body.category-regions ul.sub-menu .menu-item > a,
body.category-regions ul.sub-menu .elementor-sub-item {
  border-left-color: transparent !important;
  border-right-color: transparent !important;
}

body.category-regions .elementor-nav-menu--dropdown .menu-item::before,
body.category-regions .elementor-nav-menu--dropdown .menu-item::after,
body.category-regions .elementor-nav-menu--dropdown .menu-item > a::before,
body.category-regions .elementor-nav-menu--dropdown .menu-item > a::after,
body.category-regions .elementor-nav-menu--dropdown .elementor-sub-item::before,
